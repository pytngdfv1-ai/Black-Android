@@ -0,0 +1,93 @@
+// Personal item markers: on F6 to F9 the player's position is saved as an intel, laptop, weapon or recon spot of the level
+// chosen in the panel, to spots.txt beside the game, and drawn in the level (esp.cpp) from then on
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+#include <cstdio>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+#include "core/log.h"
+#include "game/layout.h"
+#include "common/options.h"
+#include "game/spots.h"
+#include "kernel/memory.h"
+
+using namespace kernel;
+
+namespace game {
+namespace {
+
+std::vector<Spot> g_spots;
+bool g_loaded;
+
+std::filesystem::path File() {
+    wchar_t path[MAX_PATH];
+    GetModuleFileNameW(nullptr, path, MAX_PATH);
+    return std::filesystem::path(path).parent_path() / "spots.txt";
+}
+
+void Load() {
+    g_loaded = true;
+    FILE* f = _wfopen(File().c_str(), L"r");
+    if (!f) return;
+    Spot s;
+    while (std::fscanf(f, "%d %d %f %f %f", &s.level, &s.type, &s.pos[0], &s.pos[1], &s.pos[2]) == 5) g_spots.push_back(s);
+    std::fclose(f);
+}
+
+void Save() {
+    FILE* f = _wfopen(File().c_str(), L"w");
+    if (!f) return;
+    for (const Spot& s : g_spots) std::fprintf(f, "%d %d %.3f %.3f %.3f\n", s.level, s.type, s.pos[0], s.pos[1], s.pos[2]);
+    std::fclose(f);
+}
+
+bool GameFocused() {
+    HWND w = GetForegroundWindow();
+    DWORD pid = 0;
+    GetWindowThreadProcessId(w, &pid);
+    return pid == GetCurrentProcessId();
+}
+
+}  // namespace
+
+const std::vector<Spot>& Spots() {
+    if (!g_loaded) Load();
+    return g_spots;
+}
+
+int SpotCount(int level, int type) {
+    int n = 0;
+    for (const Spot& s : Spots()) n += s.level == level && s.type == type;
+    return n;
+}
+
+void UndoSpot() {
+    Spots();
+    if (!g_spots.empty()) g_spots.pop_back(), Save();
+}
+
+// each frame in a level: F6 to F9 mark the player's place
+void PollSpots() {
+    static bool down[5];
+    if (!R32(layout::kWorld) || !GameFocused()) return;
+    for (int k = 0; k < 5; k++) {
+        bool now = GetAsyncKeyState(k < 4 ? VK_F6 + k : VK_F5) & 0x8000;  // the fifth, destruction targets, on F5
+        if (now && !down[k]) {
+            uint32_t me = R32(layout::kWorld) + layout::kWorldPlayer;
+            Spots();
+            Spot s{int(Opt().spot_level), k, {G<float>(me + 0xA0), G<float>(me + 0xA4), G<float>(me + 0xA8)}};
+            g_spots.push_back(s);
+            Save();
+            MessageBeep(MB_OK);
+            LOGR("spots: level %d type %d at %.2f %.2f %.2f", s.level, s.type, s.pos[0], s.pos[1], s.pos[2]);
+        }
+        down[k] = now;
+    }
+}
+
+}  // namespace game
