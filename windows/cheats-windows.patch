diff --git a/src/game/objects.cpp b/src/game/objects.cpp
new file mode 100644
index 0000000..cbb3421
--- /dev/null
+++ b/src/game/objects.cpp
@@ -0,0 +1,142 @@
+// Discovery for the cheats page's object markers: LOG OBJECTS writes the game's live objects to the log, grouped by
+// class (the first word of an object points to a table of code addresses). The counts of a class are the way to
+// tell what each is: a level has so many intel, laptops and weapons to find. Run it in a level, then send the log
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <utility>
+#include <cstdio>
+#include <map>
+#include <vector>
+
+#include "core/log.h"
+#include "common/options.h"
+#include "game/layout.h"
+#include "game/spots.h"
+#include "kernel/memory.h"
+#include "xdk/hle.h"
+
+using namespace kernel;
+
+namespace {
+
+// the image: code below, its tables above; objects sit past it
+constexpr uint32_t kCodeLow = 0x00010000;
+constexpr uint32_t kCodeHigh = 0x00290000;
+constexpr uint32_t kTableHigh = 0x00400000;
+constexpr uint32_t kHeapLow = 0x00400000;
+constexpr uint32_t kHeapHigh = 0x40000000;
+constexpr uint32_t kMaxPerClass = 4096;
+constexpr uint32_t kShown = 2;     // objects of a class dumped
+constexpr uint32_t kBytes = 0x100;  // from each
+
+bool Code(uint32_t va) { return va >= kCodeLow && va < kCodeHigh; }
+
+bool Readable(uint32_t va, uint32_t size) {
+    for (uint32_t p = va & ~0xFFFu; p < va + size; p += 0x1000)
+        if (!mem::IsCommitted(p)) return false;
+    return true;
+}
+
+// the table at v holds code addresses: a class's virtual functions
+bool Table(uint32_t v) {
+    if (v < kCodeLow || v >= kTableHigh || (v & 3) || !Readable(v, 8)) return false;
+    return Code(R32(v)) && Code(R32(v + 4));
+}
+
+}  // namespace
+
+namespace game {
+
+// the saved spots (F6 to F9) are where items were picked up: every place in memory that holds a position within a metre
+// or so of one is logged with the words round it, so the object an item is, and its class, can be told from the log
+void DumpObjects() {
+    int level = int(game::Opt().spot_level);
+    LOGR("objects: spots of level %d: %zu", level, game::Spots().size());
+    for (const game::Spot& s : game::Spots()) {
+        if (s.level != level) continue;
+        struct Hit {
+            uint32_t at;
+            float d;
+        };
+        std::vector<Hit> hits;
+        for (uint32_t page = kHeapLow; page != 0x84000000; page += 0x1000) {
+            if (page == kHeapHigh) page = 0x80000000;
+            if (!mem::IsCommitted(page) || !mem::IsCommitted(page + 0x1000 - 4)) continue;
+            for (uint32_t at = page; at + 12 <= page + 0x1000; at += 4) {
+                float x = G<float>(at), y = G<float>(at + 4), z = G<float>(at + 8);
+                if (!(std::fabs(x - s.pos[0]) < 1.6f && std::fabs(z - s.pos[2]) < 1.6f && std::fabs(y - s.pos[1]) < 3.0f)) continue;
+                hits.push_back({at, std::fabs(x - s.pos[0]) + std::fabs(z - s.pos[2])});
+            }
+        }
+        std::sort(hits.begin(), hits.end(), [](const Hit& a, const Hit& b) { return a.d < b.d; });
+        LOGR("objects: spot type %d at %.2f %.2f %.2f: %zu hits", s.type, s.pos[0], s.pos[1], s.pos[2], hits.size());
+        for (size_t i = 0; i < hits.size() && i < 60; i++) {
+            uint32_t at = hits[i].at;
+            char line[220];
+            int n = std::snprintf(line, sizeof(line), "objects:  %08X  %.2f %.2f %.2f  |", at, G<float>(at), G<float>(at + 4), G<float>(at + 8));
+            for (int w = -6; w < 10; w++) n += std::snprintf(line + n, sizeof(line) - n, " %08X", R32(at + w * 4));
+            LOGR("%s", line);
+        }
+    }
+    LOGR("objects: done");
+}
+
+// find what changes when an item is picked up: A1 and A2 a second apart tell what changes by itself, B after the pickup;
+// what differs in B and was still in A1 and A2 belongs to the item (its object, flags, the HUD count). Logged in clusters
+namespace {
+constexpr uint32_t kFromVa = 0x81000000, kToVa = 0x84000000, kWords = (kToVa - kFromVa) / 4;
+std::vector<uint32_t> g_a1, g_a2;
+int g_step = 0;
+
+void Snapshot(std::vector<uint32_t>& out) {
+    out.assign(kWords, 0);
+    for (uint32_t page = kFromVa; page < kToVa; page += 0x1000)
+        if (mem::IsCommitted(page) && mem::IsCommitted(page + 0xFFC)) std::memcpy(&out[(page - kFromVa) / 4], HostPtr(page), 0x1000);
+}
+}  // namespace
+
+int FindItemStep(bool advance) {
+    if (!advance) return g_step;
+    if (g_step == 0) {
+        Snapshot(g_a1);
+        g_step = 1;
+    } else if (g_step == 1) {
+        Snapshot(g_a2);
+        g_step = 2;
+    } else {
+        std::vector<uint32_t> b;
+        Snapshot(b);
+        struct Cluster {
+            uint32_t at, count = 0;
+            std::vector<std::pair<uint32_t, uint32_t>> words;
+        };
+        std::vector<Cluster> clusters;
+        uint32_t last = 0;
+        for (uint32_t i = 0; i < kWords; i++) {
+            if (b[i] == g_a2[i] || g_a1[i] != g_a2[i]) continue;
+            uint32_t at = kFromVa + i * 4;
+            if (clusters.empty() || at - last > 0x40) clusters.push_back({at});
+            Cluster& c = clusters.back();
+            c.count++;
+            if (c.words.size() < 8) c.words.push_back({g_a2[i], b[i]});
+            last = at;
+        }
+        LOGR("objects: item diff: %zu clusters", clusters.size());
+        size_t shown = 0;
+        for (Cluster& c : clusters) {
+            if (shown++ >= 400) break;
+            char line[200];
+            int n = std::snprintf(line, sizeof(line), "objects: diff %08X x%u:", c.at, c.count);
+            for (auto& [was, now] : c.words) n += std::snprintf(line + n, sizeof(line) - n, " %08X>%08X", was, now);
+            LOGR("%s", line);
+        }
+        LOGR("objects: item diff done");
+        g_step = 0;
+        g_a1.clear(), g_a2.clear();
+        g_a1.shrink_to_fit(), g_a2.shrink_to_fit();
+    }
+    return g_step;
+}
+
+}  // namespace game
diff --git a/src/game/spots.cpp b/src/game/spots.cpp
new file mode 100644
