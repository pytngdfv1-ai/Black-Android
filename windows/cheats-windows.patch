+        case WM_ENTERSIZEMOVE:
+            g_sizing = true;
+            break;
+        case WM_EXITSIZEMOVE:
+            g_sizing = false;
+            FollowWindow(static_cast<HWND>(hwnd));
+            break;
+        case WM_SIZE:
+            if (!g_sizing && wp != SIZE_MINIMIZED) FollowWindow(static_cast<HWND>(hwnd));
