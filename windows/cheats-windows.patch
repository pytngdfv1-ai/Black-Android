+// Windowed: the window's client size is the output (the settings' resolution), so dragging its edges or maximizing
+// it resizes the game: the aspect, the render targets and the HUD follow. While an edge is dragged only the swap
+// chain follows, the output is taken when the drag ends
+bool g_sizing = false;
+
+void FollowWindow(HWND hwnd) {
+    app::Settings& s = app::Get();
+    if (s.display_mode != app::DisplayMode::Windowed || IsIconic(hwnd)) return;
+    RECT rc;
+    GetClientRect(hwnd, &rc);
+    uint32_t w = uint32_t(rc.right - rc.left), h = uint32_t(rc.bottom - rc.top);
+    if (w < 320 || h < 240 || (s.width == w && s.height == h)) return;
+    s.width = w;
+    s.height = h;
+    app::Save();
+}
+
