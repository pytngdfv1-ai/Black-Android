@@ -0,0 +1,92 @@
+// The minimap's memory: a cell of the ground is kept once the player stood on or beside it, per level and floor, in
+// map_<level>.bin beside the game (written every few seconds), so the map of a level fills in as it is played
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <map>
+#include <set>
+
+#include "game/map.h"
+
+namespace game {
+namespace {
+
+constexpr float kCell = 2.0f;  // metres
+constexpr float kFloor = 3.0f;
+
+struct Level {
+    std::set<uint64_t> keys;
+    std::vector<MapCell> cells;
+    bool dirty = false;
+};
+std::map<int, Level> g_levels;
+std::chrono::steady_clock::time_point g_saved;
+
+uint64_t Key(int x, int z, int f) { return (uint64_t(uint32_t(x)) << 32) ^ (uint64_t(uint16_t(z)) << 16) ^ uint16_t(f); }
+
+std::filesystem::path File(int level) {
+    wchar_t path[MAX_PATH];
+    GetModuleFileNameW(nullptr, path, MAX_PATH);
+    return std::filesystem::path(path).parent_path() / (L"map_" + std::to_wstring(level) + L".bin");
+}
+
+void Add(Level& l, int x, int z, int f) {
+    if (l.keys.insert(Key(x, z, f)).second) l.cells.push_back({x, z, f}), l.dirty = true;
+}
+
+Level& Get(int level) {
+    auto it = g_levels.find(level);
+    if (it != g_levels.end()) return it->second;
+    Level& l = g_levels[level];
+    if (FILE* f = _wfopen(File(level).c_str(), L"rb")) {
+        int32_t c[3];
+        while (std::fread(c, sizeof(c), 1, f) == 1) Add(l, c[0], c[1], c[2]);
+        std::fclose(f);
+    }
+    l.dirty = false;
+    return l;
+}
+
+void Save(int level, Level& l) {
+    if (FILE* f = _wfopen(File(level).c_str(), L"wb")) {
+        for (const MapCell& c : l.cells) {
+            int32_t v[3] = {c.x, c.z, c.floor};
+            std::fwrite(v, sizeof(v), 1, f);
+        }
+        std::fclose(f);
+    }
+    l.dirty = false;
+}
+
+}  // namespace
+
+int MapFloor(float y) { return int(std::floor((y + 1.5f) / kFloor)); }
+
+void MapVisit(int level, const float pos[3]) {
+    Level& l = Get(level);
+    int x = int(std::floor(pos[0] / kCell)), z = int(std::floor(pos[2] / kCell)), f = MapFloor(pos[1]);
+    Add(l, x, z, f);  // and the four beside it: a trail a few metres wide
+    Add(l, x + 1, z, f), Add(l, x - 1, z, f), Add(l, x, z + 1, f), Add(l, x, z - 1, f);
+    auto now = std::chrono::steady_clock::now();
+    if (l.dirty && now - g_saved > std::chrono::seconds(5)) g_saved = now, Save(level, l);
+}
+
+const std::vector<MapCell>& MapCells(int level) { return Get(level).cells; }
+
+void MapClear(int level) {
+    Level& l = Get(level);
+    l.keys.clear(), l.cells.clear();
+    Save(level, l);
+}
+
+}  // namespace game
